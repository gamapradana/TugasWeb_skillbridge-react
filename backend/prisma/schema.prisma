generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id         Int    @id @default(autoincrement())
  posisi     String
  perusahaan String
  lokasi     String
  tipe       String
  gaji       Int
  deskripsi  String
}
